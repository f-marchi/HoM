---
import CtaLink from "@components/CtaLink.astro";
import QuoteBlock from "@components/QuoteBlock.astro";
import VideoCard from "@components/VideoCard.astro";
import { withBase } from "@components/url.js";
import { ourWorkPage } from "@data/site.mjs";
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout title={ourWorkPage.title} description={ourWorkPage.description}>
  <section class="hero work-hero">
    <video class="hero-video" autoplay muted loop playsinline poster={withBase(ourWorkPage.intro.poster)}>
      <source src={withBase(ourWorkPage.intro.video)} type="video/mp4" />
    </video>
    <div class="hero-inner">
      <h1>{ourWorkPage.intro.title}</h1>
      <div class="lead">
        {ourWorkPage.intro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <nav class="anchor-nav" aria-label="Our Work sections">
        {ourWorkPage.anchors.map((anchor) => <a href={anchor.href}>{anchor.label}</a>)}
      </nav>
    </div>
  </section>

  {
    ourWorkPage.categories.map((category) => (
      <section id={category.id} class="work-section">
        <div class="container">
          <h2>{category.title}</h2>
          <div class="video-grid">
            {category.items.map((item) => <VideoCard item={item} />)}
          </div>
        </div>
      </section>
    ))
  }

  <section id={ourWorkPage.legacy.id} class="work-section">
    <div class="container">
      <h2>{ourWorkPage.legacy.title}</h2>
      <div class="video-grid">
        {ourWorkPage.legacy.items.map((item) => <VideoCard item={item} />)}
      </div>
    </div>
  </section>

  <section id={ourWorkPage.interviews.id} class="work-section">
    <div class="container">
      <h2>{ourWorkPage.interviews.title}</h2>
      <div class="video-grid">
        {ourWorkPage.interviews.items.map((item) => <VideoCard item={item} />)}
      </div>
    </div>
  </section>

  <section id={ourWorkPage.takeThisChemo.id} class="work-section book-section">
    <div class="container book-panel">
      <div class="book-images">
        {
          ourWorkPage.takeThisChemo.images.map((image) => (
            <img src={withBase(image.src)} alt={image.alt} loading="lazy" />
          ))
        }
      </div>
      <div class="content-section">
        <h2>{ourWorkPage.takeThisChemo.title}</h2>
        <p class="eyebrow">{ourWorkPage.takeThisChemo.subtitle}</p>
        <p>{ourWorkPage.takeThisChemo.description}</p>
        <div class="button-row">
          <CtaLink
            href={ourWorkPage.takeThisChemo.checkItOut.href}
            label={ourWorkPage.takeThisChemo.checkItOut.label}
          />
          <CtaLink
            href={ourWorkPage.takeThisChemo.buy.href}
            label={ourWorkPage.takeThisChemo.buy.label}
            variant="secondary"
          />
        </div>
        <p class="person">{ourWorkPage.takeThisChemo.availability}</p>
        <p>{ourWorkPage.takeThisChemo.availabilitySubtitle}</p>
      </div>
    </div>
  </section>

  <QuoteBlock quote={ourWorkPage.quote} />
</BaseLayout>
