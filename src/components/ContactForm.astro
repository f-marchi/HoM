---
const { contact } = Astro.props;
const mailto = `mailto:${contact.recipient}?subject=Heroes%20of%20Medicine%20Contact`;
---

<section class="contact-panel" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">{contact.subtitle}</p>
    <h2 id="contact-title">{contact.title}</h2>
    <p>{contact.emailLine}</p>
  </div>
  <form action={mailto} method="get">
    <label>
      Name
      <input name="name" autocomplete="name" />
    </label>
    <label>
      Email
      <input name="email" type="email" autocomplete="email" />
    </label>
    <label>
      Subject
      <input name="subject" value="Heroes of Medicine Contact" />
    </label>
    <label>
      Message
      <textarea name="body" rows="6"></textarea>
    </label>
    <button class="button primary" type="submit">SUBMIT</button>
  </form>
</section>
