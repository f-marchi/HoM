---
import { youtubeEmbedUrl } from "./url.js";

const { item, compact = false } = Astro.props;
const label = item.title || item.url;
---

<article class:list={["video-card", compact && "compact"]} data-video-source={item.url}>
  <div class="video-frame">
    <iframe
      src={youtubeEmbedUrl(item.url)}
      title={label}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  <div class="video-copy">
    {item.eyebrow && <p class="eyebrow">{item.eyebrow}</p>}
    {item.title && <h3>{item.title}</h3>}
    {item.person && <p class="person">{item.person}</p>}
    {item.quote && <p class="story-quote">{item.quote}</p>}
    {item.description && <p>{item.description}</p>}
    <a href={item.url} class="text-link">Watch on YouTube</a>
  </div>
</article>
